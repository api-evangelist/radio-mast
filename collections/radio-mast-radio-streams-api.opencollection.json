{
  "opencollection": "1.0.0",
  "info": {
    "name": "Radio Mast Analytics Radio Streams API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Radio Streams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Radio Mast streams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.radiomast.io/v1/radiostreams/radiomast/"
          },
          "docs": "List Radio Mast streams"
        },
        {
          "info": {
            "name": "List external streams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.radiomast.io/v1/radiostreams/external/"
          },
          "docs": "List external streams"
        }
      ]
    }
  ],
  "bundled": true
}